{
  "name": "math-class-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run portraits:check && node scripts/render-theorems.mjs && node scripts/generate-health.mjs",
    "prebuild": "npm run portraits:check && node scripts/render-theorems.mjs && node scripts/generate-health.mjs",
    "dev": "vite",
    "build": "vite build",
    "health:generate": "node scripts/generate-health.mjs",
    "portraits:check": "node scripts/check-portraits.mjs",
    "portraits:fetch": "node scripts/fetch-portraits.mjs",
    "theorems:render": "node scripts/render-theorems.mjs",
    "vocab:import": "node scripts/import-vocabulary.mjs",
    "lint": "eslint . --ext js,jsx,mjs --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.toml --outdir worker/.wrangler/check"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/pinyon-script": "^5.3.0",
    "@supabase/supabase-js": "^2.97.0",
    "classnames": "^2.5.1",
    "katex": "^0.16.45",
    "lucide-react": "^0.574.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "vercel": "^53.1.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.87.0"
  },
  "overrides": {
    "jayson": {
      "ws": "^7.5.11"
    }
  }
}
